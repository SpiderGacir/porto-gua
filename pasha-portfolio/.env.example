# Semua ini rahasia: isi di .env.local (lokal) dan di Environment Variables hosting. JANGAN di-commit.

# Gemini (Google AI Studio) untuk AI di Code Lab
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase (Project Settings -> API). Service role key HANYA dipakai di server.
SUPABASE_URL=
# Boleh key baru (sb_secret_...) atau key lama (service_role, eyJ...)
SUPABASE_SERVICE_ROLE_KEY=

# Email untuk form kontak (opsional, via resend.com). Tanpa ini pesan tetap masuk ke tabel Supabase.
RESEND_API_KEY=
CONTACT_TO=email-kamu@gmail.com
CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Opsional: host terpisah untuk situs publish (mis. s.domain.com)
SITES_HOST=
NEXT_PUBLIC_SITES_URL=
# Kalau SITES_HOST dipakai, isi alamat utama portfolio (buat link Laporkan): https://domain.com
NEXT_PUBLIC_MAIN_URL=
